{% for port in compliance_access_ports %}
interface {{ port.name }}
 storm-control broadcast level {{ stig_controls['V-220662'].broadcast_level | default('10.00') }}
 storm-control unicast level {{ stig_controls['V-220662'].unicast_level | default('10.00') }}
{% endfor %}
{% for port in compliance_voice_ports | default([]) %}
interface {{ port.name }}
 storm-control broadcast level {{ stig_controls['V-220662'].broadcast_level | default('10.00') }}
 storm-control unicast level {{ stig_controls['V-220662'].unicast_level | default('10.00') }}
{% endfor %}
